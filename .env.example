# Copiar a .env y llenar con valores reales (nunca commitear .env).
# Ver docs/decisions/ADR-006.md — separación de roles de conexión.

# --- sige_migrator: owner de las tablas, usado únicamente por Alembic ---
# El backend en runtime NUNCA debe usar estas credenciales.
DB_MIGRATOR_USER=sige_migrator
DB_MIGRATOR_PASSWORD=changeme_migrator

# --- sige_app: rol de runtime del backend (NOSUPERUSER, solo DML) ---
# Es el único rol con el que FastAPI/SQLAlchemy abre conexiones.
DB_APP_USER=sige_app
DB_APP_PASSWORD=changeme_app

# --- DSNs derivados de los roles anteriores ---
# Usado exclusivamente por Alembic (app/db/migrations).
DATABASE_URL_MIGRATIONS=postgresql://sige_migrator:changeme_migrator@db:5432/sige

# Usado exclusivamente por la aplicación FastAPI (app/core/config.py).
DATABASE_URL=postgresql://sige_app:changeme_app@db:5432/sige
